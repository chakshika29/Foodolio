# Server Port
PORT=4000

# MongoDB Connection String (e.g. MongoDB Atlas or local mongodb://127.0.0.1:27017/food-del)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/food-del

# JWT Secret Key for user authentication tokens
JWT_SECRET=foodolio_super_secret_jwt_key

# Stripe Secret Key (optional for COD; required for Stripe card payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Frontend URL (used by Stripe redirect and CORS)
FRONTEND_URL=http://localhost:5173

# Admin Panel URL (used by CORS)
ADMIN_URL=http://localhost:5174
