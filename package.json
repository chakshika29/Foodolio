{
  "name": "foodolio",
  "version": "1.0.0",
  "description": "Foodolio Food Delivery Fullstack Application",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node dev.js",
    "dev:all": "node dev.js --all",
    "dev:backend": "npm --prefix backend run server",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:admin": "npm --prefix admin run dev",
    "build:frontend": "npm --prefix frontend run build",
    "build:admin": "npm --prefix admin run build",
    "build": "npm --prefix frontend run build && npm --prefix admin run build",
    "install:all": "npm --prefix backend install && npm --prefix frontend install && npm --prefix admin install"
  }
}
